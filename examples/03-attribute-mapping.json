{
  "syncRules": [
    {
      "sourceSystem": "On-Premises Active Directory",
      "targetSystem": "Azure AD",
      "attributes": [
        {
          "sourceAttribute": "givenName",
          "targetAttribute": "givenName",
          "type": "direct",
          "mandatory": true
        },
        {
          "sourceAttribute": "sn",
          "targetAttribute": "surname",
          "type": "direct",
          "mandatory": true
        },
        {
          "sourceAttribute": "mail",
          "targetAttribute": "userPrincipalName",
          "type": "direct",
          "mandatory": true,
          "transformer": "email"
        },
        {
          "sourceAttribute": "department",
          "targetAttribute": "department",
          "type": "direct",
          "mandatory": false
        },
        {
          "sourceAttribute": "title",
          "targetAttribute": "jobTitle",
          "type": "direct",
          "mandatory": false
        },
        {
          "sourceAttribute": "manager",
          "targetAttribute": "manager",
          "type": "dn_resolution",
          "mandatory": false
        },
        {
          "sourceAttribute": "mobile",
          "targetAttribute": "mobilePhone",
          "type": "direct",
          "mandatory": false
        },
        {
          "sourceAttribute": "extensionAttribute1",
          "targetAttribute": "employeeId",
          "type": "direct",
          "mandatory": false
        },
        {
          "sourceAttribute": "extensionAttribute2",
          "targetAttribute": "costCenter",
          "type": "direct",
          "mandatory": false
        }
      ],
      "scoping": {
        "sourceScoping": [
          {
            "attribute": "objectClass",
            "operator": "equals",
            "value": "user"
          },
          {
            "attribute": "accountStatus",
            "operator": "equals",
            "value": "active"
          }
        ],
        "targetScoping": [
          {
            "attribute": "accountEnabled",
            "operator": "equals",
            "value": true
          }
        ]
      }
    }
  ]
}

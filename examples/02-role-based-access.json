{
  "roles": [
    {
      "roleId": "sales-rep",
      "roleName": "Sales Representative",
      "permissions": [
        {
          "resource": "Salesforce",
          "access": ["read", "create", "update"],
          "restrictions": ["cannot_delete", "cannot_export"]
        },
        {
          "resource": "Customer Database",
          "access": ["read"],
          "restrictions": ["cannot_update", "cannot_delete"]
        },
        {
          "resource": "Reporting System",
          "access": ["read"],
          "restrictions": ["cannot_create"]
        }
      ],
      "groups": ["Sales Team", "All Employees"]
    },
    {
      "roleId": "sales-manager",
      "roleName": "Sales Manager",
      "permissions": [
        {
          "resource": "Salesforce",
          "access": ["read", "create", "update", "delete"],
          "restrictions": []
        },
        {
          "resource": "Customer Database",
          "access": ["read", "update"],
          "restrictions": ["cannot_delete"]
        },
        {
          "resource": "Reporting System",
          "access": ["read", "create"],
          "restrictions": []
        },
        {
          "resource": "Team Access Management",
          "access": ["read", "create", "update"],
          "restrictions": ["cannot_delete"]
        }
      ],
      "groups": ["Sales Managers", "All Employees"],
      "reports": "can_approve_access_requests"
    },
    {
      "roleId": "finance-admin",
      "roleName": "Finance Administrator",
      "permissions": [
        {
          "resource": "Financial System",
          "access": ["read", "create", "update", "delete"],
          "restrictions": []
        },
        {
          "resource": "Expense Approvals",
          "access": ["read", "update"],
          "restrictions": ["cannot_approve_own"]
        },
        {
          "resource": "Audit Reports",
          "access": ["read"],
          "restrictions": []
        }
      ],
      "groups": ["Finance Team", "All Employees"],
      "segregationOfDuties": {
        "cannotHaveRole": ["Expense Requestor", "Payroll Administrator"]
      }
    }
  ]
}

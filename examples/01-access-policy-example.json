{
  "policyName": "Require MFA for Sensitive Resources",
  "description": "This policy requires multi-factor authentication for all users accessing finance and HR applications",
  "conditions": {
    "users": {
      "includeGroups": ["All Users"],
      "excludeGroups": ["Service Accounts", "Guest Users"]
    },
    "applications": {
      "includeApps": ["Finance Portal", "HR System", "Payroll"],
      "excludeApps": ["Public Website"]
    },
    "locations": {
      "includeLocations": ["All"],
      "untrustedLocations": ["High Risk Countries"]
    },
    "deviceStates": {
      "requireCompliant": false,
      "requireManaged": false
    },
    "signInRisk": {
      "includeRisks": ["medium", "high"]
    },
    "timeOfDay": {
      "businessHoursOnly": false,
      "comment": "Apply policy 24/7"
    }
  },
  "grantControls": {
    "operator": "AND",
    "builtInControls": [
      "mfa",
      "compliantDevice"
    ],
    "customControls": []
  },
  "sessionControls": {
    "applicationEnforcedRestrictions": true,
    "persistentBrowser": {
      "isEnabled": true,
      "mode": "always"
    },
    "signInFrequency": {
      "isEnabled": false,
      "value": 1,
      "type": "days"
    }
  },
  "state": "enabled",
  "createdDateTime": "2024-01-15T10:00:00Z",
  "modifiedDateTime": "2024-01-15T10:00:00Z"
}

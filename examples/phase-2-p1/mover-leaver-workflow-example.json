        "user": "Bob Glasgow"
      },
      {
        "step": 4,
        "description": "Update application role assignment",
        "action": "Change app role",
        "app": "Test Enterprise App",
        "old_role": "Finance User",
        "new_role": "IT Support User"
      }
    ]
  },

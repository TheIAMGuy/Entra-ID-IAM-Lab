{
  "comment": "PLACEHOLDER: Identity lifecycle changes from Lab 06 — Mover and Leaver",
  "description": "Replace this file with your own record of the changes after completing Lab 06. Values match the lab scenario.",
  "workflow_example": {
    "mover": {
      "scenario": "John Smith transfers from HR to Finance",
      "steps": [
        {
          "step": 1,
          "action": "Update user attributes",
          "changes": {
            "department": "Finance"
          }
        },
        {
          "step": 2,
          "action": "Remove from group",
          "group": "HR-Team"
        },
        {
          "step": 3,
          "action": "Add to group",
          "group": "Finance-Team"
        },
        {
          "step": 4,
          "action": "Remove application assignment",
          "app": "HR-App"
        },
        {
          "step": 5,
          "action": "Add application assignment",
          "app": "Finance-App"
        }
      ]
    },
    "leaver": {
      "scenario": "Eve Smith leaves the organisation",
      "steps": [
        {
          "step": 1,
          "action": "Disable the account (accountEnabled = false)"
        },
        {
          "step": 2,
          "action": "Remove from all groups"
        },
        {
          "step": 3,
          "action": "Remove application access"
        }
      ]
    }
  },
  "lab_reference": "https://github.com/TheIAMGuy/Entra-ID-IAM-Lab/blob/main/docs/PHASE-2-ENTRA-P1/06-identity-lifecycle-mover-leaver.md",
  "audit_verification": "Check the audit log for the matching Update user, Remove member from group, Add member to group and app role assignment events."
}

{
  "_comment": "Template for .claude/settings.json (project, shared) or .claude/settings.local.json (personal, not committed). Delete this key in your real file. Keys here follow the Claude Code settings schema: https://docs.claude.com/en/docs/claude-code/settings",

  "model": "sonnet",

  "permissions": {
    "allow": [
      "Read",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  },

  "env": {
    "_comment": "Non-secret variables only. Keep credentials in a git-ignored .env or your OS keychain, never in this file."
  },

  "hooks": {
    "_comment": "Hooks run shell commands on tool events (PreToolUse, PostToolUse, ...). They execute with your user's privileges, so review every hook before committing it to a shared repo. See the hooks docs for the exact shape."
  }
}
